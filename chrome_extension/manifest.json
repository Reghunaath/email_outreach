{
  "manifest_version": 3,
  "name": "LinkedIn URL Collector",
  "version": "1.1",
  "description": "Copies all open LinkedIn profile URLs to clipboard for the email finder app.",
  "permissions": ["tabs", "scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobs.ashbyhq.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.greenhouse.io/*"
      ],
      "js": ["ashby_fill.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copy LinkedIn URLs"
  },
  "options_page": "options.html"
}
